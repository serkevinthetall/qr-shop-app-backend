PORT=10000
ODOO_URL=
ODOO_DB=
ODOO_SERVICE_LOGIN=
ODOO_SERVICE_PASSWORD=
APP_SECRET=

# Optional: Myanmar timezone offset in minutes (default 390 = UTC+6:30)
NOTIFY_TZ_OFFSET_MINUTES=390

# Required for Odoo → API webhooks that trigger Expo push
ODOO_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Odoo Studio Char/Text field on res.partner for Expo push tokens
# (stores JSON list of devices — prefer Text or Char >= 512)
PUSH_TOKEN_PARTNER_FIELD=x_studio_expo_push_token
# Max devices kept per member (iOS + Android, etc.)
PUSH_TOKEN_MAX_PER_PARTNER=5
# Catch-up window after a device first registers (ms)
PUSH_CATCH_UP_WINDOW_MS=7200000

# Force-update (optional). Default when unset: 1.0.0 — do NOT raise until the
# new store/TestFlight build is live, or older installs will be blocked.
# APP_MIN_VERSION=1.0.1
# APP_MIN_IOS_VERSION=1.0.1
# APP_MIN_ANDROID_VERSION=1.0.0
# IOS_STORE_URL=https://apps.apple.com/app/idYOUR_APP_ID
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.qrshop.myanmar

# Optional: only if Expo push security is enabled in EAS
# EXPO_ACCESS_TOKEN=
